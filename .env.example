# Spotify API Configuration (Opsional - untuk mode Bot / Public Playlist)
# Jika dikosongkan, aplikasi tetap berjalan dengan metadata fallback (iTunes API) & direct links
SPOTIFY_CLIENT_ID=1adea15807d4408d873742491b8a021d
SPOTIFY_CLIENT_SECRET=
# Refresh token dari akun Bot/Curator Spotify (bukan user akhir!)
# Jika diisi, bot akan otomatis membuat playlist Spotify publik untuk user
SPOTIFY_BOT_REFRESH_TOKEN=

# Instagram Configuration (Opsional)
# Masukkan sessionid jika ingin scraping akun tanpa terkena batasan 403/429
INSTAGRAM_SESSION_ID=
SCRAPE_DELAY_SECONDS=1.5
